# Copy to .env.local for local development. Never commit real values.
# Supabase → Project Settings → API (use the *publishable* key, never the secret/service key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app in the current environment (used for auth redirect links)
# local: http://localhost:3000 · development: https://dev.serbi.me · production: https://serbi.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps (browser key, restricted by HTTP referrer to your domains). APIs to enable:
# Maps JavaScript API, Places API (New), Geocoding API. Optional: without it the register form
# shows manual address + coordinates fields.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID (Google Cloud → Map Management) for the draggable Advanced Marker. Optional.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only. Used ONLY by `npm run admin:create` on your machine. Never commit; never set in Vercel.
# SUPABASE_SECRET_KEY=
