# Copy to .env.local for local development. Never commit real values.
# Supabase → Project Settings → API (use the *publishable* key, never the secret/service key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app in the current environment (used for auth redirect links)
# local: http://localhost:3000 · development: https://dev.serbi.me · production: https://serbi.me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maps — SERVER-ONLY keys (no NEXT_PUBLIC_ prefix, never sent to the browser).
# Used by /api/places/*, /api/geocode/reverse and /api/maps/static. Without any key the
# register form shows manual coordinates + address fields.
# Geoapify (default, free plan without credit card): https://myprojects.geoapify.com
GEOAPIFY_API_KEY=
# Google (optional, needs billing): Places API (New), Geocoding API, Maps Static API.
GOOGLE_MAPS_SERVER_KEY=
# Optional: force a provider (geoapify | google). Default: Geoapify if its key is set.
MAPS_PROVIDER=

# Server-only. Used ONLY by `npm run admin:create` on your machine. Never commit; never set in Vercel.
# SUPABASE_SECRET_KEY=
